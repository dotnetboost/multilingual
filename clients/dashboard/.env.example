# Only needed when the dashboard should talk to an API other than the sample on its default port.

# Base address of the API the dashboard reads and writes: the language endpoints that
# MapLanguageEndpoints() maps, and the sample's content endpoints. Used server-side by the
# /api/** proxy.
NUXT_MULTILINGUAL_API_URL=http://localhost:5160

# Where the sidebar's "API reference" link points.
NUXT_PUBLIC_API_REFERENCE_URL=http://localhost:5160/scalar

# The API's MultiLingualOptions.BaseLanguage — the language kept in each entity's own columns.
# Leave it empty for an API that stores every language in Translations.
NUXT_PUBLIC_BASE_LANGUAGE=en
