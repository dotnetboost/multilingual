<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DotNetBoost.MultiLingual.MongoDb</PackageId>
    <Description>
      MongoDB provider for DotNetBoost.MultiLingual. Translations live in one collection, keyed by
      (entity name, entity id, property name, language code); translatable properties are unmapped
      from the entity's own documents and read and written through IMultiLingualManager.
      There is no change tracker to hook, so application code localizes after a query and saves
      translations alongside its own writes — see docs/adding-a-provider.md.
    </Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The stores, the class-map convention and the index service are internals; the tests
         exercise the stores through the shared contract suites. -->
    <InternalsVisibleTo Include="DotNetBoost.MultiLingual.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DotNetBoost.MultiLingual.Core/DotNetBoost.MultiLingual.Core.csproj" />
    <PackageReference Include="MongoDB.Driver" />
    <!-- IHostedService only, for the one-time index creation. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
