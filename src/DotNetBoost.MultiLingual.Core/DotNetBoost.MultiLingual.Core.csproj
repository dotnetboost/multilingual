<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DotNetBoost.MultiLingual.Core</PackageId>
    <Description>
      Core abstractions and engine for DotNetBoost.MultiLingual — attribute-driven translatable
      content for any entity, backed by a single translations store.
      Includes ITranslationManager, ITranslationStore, ILanguageStore, the language catalog and
      the provider-neutral read (hydrate with default-language fallback) and write paths.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The write buffer and hydrated-value tracker are engine internals; the unit tests cover
         them directly rather than only through the public surface. -->
    <InternalsVisibleTo Include="DotNetBoost.MultiLingual.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- IHostedService only, for the startup check that the base language actually exists. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
