<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DotNetBoost.MultiLingual.Core</PackageId>
    <Description>
      Core abstractions and engine for DotNetBoost.MultiLingual — attribute-driven translatable
      content for any entity, backed by a single translations store.
      Includes IMultiLingualManager — the one service application code injects — the store
      contracts (ITranslationStore, ILanguageStore, ITranslationWriter) for storage providers, and
      the provider-neutral read (hydrate with default-language fallback) and write paths.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine services (language context and catalog, translation and language managers) are
         internal: applications use IMultiLingualManager. The sibling packages build on the engine
         directly, as the storage providers do — a first-party Dapper provider would be added here
         too. -->
    <InternalsVisibleTo Include="DotNetBoost.MultiLingual.EntityFrameworkCore" />
    <InternalsVisibleTo Include="DotNetBoost.MultiLingual.MongoDb" />
    <InternalsVisibleTo Include="DotNetBoost.MultiLingual.API" />
    <InternalsVisibleTo Include="DotNetBoost.MultiLingual.Localization" />
    <!-- The tests cover the engine directly rather than only through the public surface. -->
    <InternalsVisibleTo Include="DotNetBoost.MultiLingual.UnitTests" />
    <InternalsVisibleTo Include="DotNetBoost.MultiLingual.ProviderTests" />
    <InternalsVisibleTo Include="DotNetBoost.MultiLingual.IntegrationTests" />
    <InternalsVisibleTo Include="DotNetBoost.MultiLingual.ApiTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- IDistributedCache only, for the opt-in cross-instance language change signal. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- IHostedService only, for the startup check that the base language actually exists. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
