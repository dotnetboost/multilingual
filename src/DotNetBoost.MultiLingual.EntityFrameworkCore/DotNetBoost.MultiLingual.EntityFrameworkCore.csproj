<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DotNetBoost.MultiLingual.EntityFrameworkCore</PackageId>
    <Description>
      Entity Framework Core provider for DotNetBoost.MultiLingual. Translatable properties are
      removed from the model and read and written transparently through interceptors — no
      repository, service or migration changes per entity. Supports SQL Server, PostgreSQL and SQLite.
    </Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The interceptors, the hydrator and the materialized-entity registry are internals; the
         provider tests exercise the registry's capacity directly. -->
    <InternalsVisibleTo Include="DotNetBoost.MultiLingual.ProviderTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DotNetBoost.MultiLingual.Core/DotNetBoost.MultiLingual.Core.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
</Project>
