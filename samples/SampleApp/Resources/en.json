{
  // Messages the API itself returns, in English. Keys are what the code passes to
  // IStringLocalizer — nested objects join with dots: Products.NotFound.
  "Errors": {
    "NotFound": "Resource not found",
    "Invalid": "Invalid request",
    "Conflict": "Conflict",
    "Unexpected": "Unexpected error",
    "UnexpectedDetail": "An unexpected error occurred while processing the request."
  },
  "Products": {
    "Created": "Product {0} was created.",
    "Updated": "Product {0} was updated.",
    "Deleted": "Product {0} was deleted.",
    "TranslationCleared": "The '{1}' translation of product {0} was removed.",
    "BulkDeleted": "Products deleted: {0}. Translations left behind and removed: {1}.",
    "NotFound": "Product {0} was not found.",
    "SkuExists": "A product with SKU '{0}' already exists.",
    "UnknownSort": "Unknown sort '{0}'. Use 'id', 'name' or '-name'."
  },
  "Categories": {
    "Created": "Category '{0}' was created.",
    "Updated": "Category '{0}' was updated.",
    "Deleted": "Category '{0}' was deleted.",
    "NotFound": "Category {0} was not found.",
    "SlugExists": "A category with slug '{0}' already exists."
  },

  // The library's base-language refusal, worded for this API: English is the base language here.
  "MultiLingual": {
    "Problems": {
      "BaseLanguageNotTranslatable": {
        "Detail": "'{0}' is the base language: its text is the {1}'s own columns, not a translation. Change it with PUT instead."
      }
    }
  }
}
