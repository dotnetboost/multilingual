<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Pure JSON API: no wwwroot, so skip the static web assets manifest. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DotNetBoost.MultiLingual.Core/DotNetBoost.MultiLingual.Core.csproj" />
    <ProjectReference Include="../../src/DotNetBoost.MultiLingual.EntityFrameworkCore/DotNetBoost.MultiLingual.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../src/DotNetBoost.MultiLingual.API/DotNetBoost.MultiLingual.API.csproj" />
    <ProjectReference Include="../../src/DotNetBoost.MultiLingual.Localization/DotNetBoost.MultiLingual.Localization.csproj" />
    <!-- OpenTelemetry, health checks, service discovery and resilient HttpClients. -->
    <ProjectReference Include="../../aspire/DotNetBoost.MultiLingual.ServiceDefaults/DotNetBoost.MultiLingual.ServiceDefaults.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <!--
    Database. Exactly one group below is active; it must match the active block in Program.cs
    and the container started by aspire/DotNetBoost.MultiLingual.AppHost.
  -->
  <ItemGroup Label="Database — ACTIVE: PostgreSQL (EF Core)">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup Label="Database — ALTERNATIVE: SQL Server (EF Core)">
    <!-- <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" /> -->
  </ItemGroup>

  <ItemGroup Label="Database — ALTERNATIVE: SQLite (EF Core, no container)">
    <!-- <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" /> -->
  </ItemGroup>

  <!--
    MongoDB is a different PROVIDER, not just a different engine, so this alternative swaps the
    project reference as well: DotNetBoost.MultiLingual.MongoDb replaces
    DotNetBoost.MultiLingual.EntityFrameworkCore above, and the EF Core database packages and the
    health-check package go with it. Data/AppDbContext.cs and Data/DbInitializer.cs then hold code
    nothing calls — see the commented blocks in each for the MongoDB shape.
  -->
  <ItemGroup Label="Database — ALTERNATIVE: MongoDB">
    <!-- <ProjectReference Include="../../src/DotNetBoost.MultiLingual.MongoDb/DotNetBoost.MultiLingual.MongoDb.csproj" /> -->
  </ItemGroup>
</Project>
