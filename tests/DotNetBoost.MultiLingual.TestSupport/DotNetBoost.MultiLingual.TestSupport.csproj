<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared test doubles, not a test project itself. The in-memory stores run the same
       contract suite as the real providers (see ProviderTests), so tests built on them are
       testing against something that is known to behave like a real store. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DotNetBoost.MultiLingual.Core/DotNetBoost.MultiLingual.Core.csproj" />
  </ItemGroup>
</Project>
